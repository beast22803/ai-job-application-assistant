# ── LLM Provider ─────────────────────────────────────────────────────────────
# "openrouter" (cloud), "ollama" (local) or "opencode" (local opencode CLI/server).
PROVIDER=openrouter

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Comma-separated fallbacks (keep them large models)
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free

# ── opencode (PROVIDER=opencode; backend must run on the machine that has opencode) ──
# OPENCODE_MODEL=openrouter/openai/gpt-oss-120b   # see `opencode models`
# OPENCODE_VARIANT=high
# OPENCODE_SERVER_URL=http://127.0.0.1:4096       # from `opencode serve`; omit to spawn `opencode run`
# OPENCODE_SERVER_PASSWORD=

# ── Ollama (local) ───────────────────────────────────────────────────────────
# Default base URL when Ollama is running locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Agent Behaviour ───────────────────────────────────────────────────────────
# How many self-improvement iterations to run before returning final output
MAX_ITERATIONS=2

# ── Jina Reader (Crawler) ─────────────────────────────────────────────────────
# Optional: Get your key at https://jina.ai/reader/
JINA_API_KEY=
